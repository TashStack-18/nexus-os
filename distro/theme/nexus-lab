    def _on_run_kernel_suite(self, _):
        self.btn_run_suite.set_sensitive(False)
        self.suite_status.set_text("Status: Running in-kernel test suite in QEMU...")
        self.suite_buf.set_text("Booting Rust Micro-OS Kernel test suite...\n")

        def worker():
            cmd = ["qemu-system-riscv64", "-machine", "virt", "-cpu", "rv64", "-smp", "1",
                   "-m", "128M", "-bios", "default", "-nographic",
                   "-kernel", "/opt/micro-os/microos.elf", "-append", "test=all"]
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
                lines = []
                for line in proc.stdout:
                    if "[PASS]" in line or "checks:" in line or "ticks=" in line or "heap at shutdown" in line:
                        lines.append(line)
                        GLib.idle_add(lambda l=line: (
                            self.suite_buf.insert(self.suite_buf.get_end_iter(), l),
                            self.suite_console.scroll_to_iter(self.suite_buf.get_end_iter(), 0, False, 0, 0)
                        ))
                rc = proc.wait()
                def on_done():
                    self.btn_run_suite.set_sensitive(True)
                    if rc == 0:
                        self.suite_status.set_text("Status: Completed — 68/68 CHECKS PASSED (100% SUCCESS)")
                    else:
                        self.suite_status.set_text(f"Status: Finished with return code {rc}")
                GLib.idle_add(on_done)
            except Exception as e:
                GLib.idle_add(lambda: (
                    self.suite_buf.insert(self.suite_buf.get_end_iter(), f"Execution error: {e}\n"),
                    self.suite_status.set_text("Status: Error running QEMU"),
                    self.btn_run_suite.set_sensitive(True)
                ))

        threading.Thread(target=worker, daemon=True).start()

