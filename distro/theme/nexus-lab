    def _draw_chart(self, widget, cr):
        width = widget.get_allocated_width()
        height = widget.get_allocated_height()

        # Background
        cr.set_source_rgb(0.06, 0.08, 0.14)
        cr.rectangle(0, 0, width, height)
        cr.fill()

        # Grid lines
        cr.set_source_rgba(0.2, 0.28, 0.45, 0.4)
        cr.set_line_width(1.0)

        left_m = 60
        right_m = width - 40
        top_m = 25
        bottom_m = height - 35

        for i in range(5):
            y = top_m + (bottom_m - top_m) * (i / 4.0)
            cr.move_to(left_m, y)
            cr.line_to(right_m, y)
            cr.stroke()

            # Axis label
            j_val = 1.0 - (i / 4.0)
            cr.set_source_rgb(0.6, 0.68, 0.8)
            cr.move_to(15, y + 4)
            cr.show_text(f"{j_val:.2f}")
            cr.set_source_rgba(0.2, 0.28, 0.45, 0.4)

        # Axis Titles
        cr.set_source_rgb(0.7, 0.78, 0.9)
        cr.move_to(left_m, bottom_m + 22)
        cr.show_text("Throughput (jobs per 100 ms)  ──►")
        cr.move_to(15, top_m - 8)
        cr.show_text("Jain Fairness ▲")

        # Plot points from self.lab_data
        colors = [
            (0.9, 0.3, 0.3), (0.2, 0.8, 0.4), (0.3, 0.6, 1.0),
            (0.9, 0.6, 0.2), (0.7, 0.4, 0.9), (0.2, 0.9, 0.9), (1.0, 0.8, 0.2)
        ]

        if hasattr(self, "chart_points") and self.chart_points:
            for i, p in enumerate(self.chart_points):
                pol_name, thr, jain = p
                # Map thr (4.0 .. 8.0) to x
                x = left_m + (right_m - left_m) * ((thr - 4.5) / 3.5)
                # Map jain (0.0 .. 1.0) to y
                y = bottom_m - (bottom_m - top_m) * jain

                r, g, b = colors[i % len(colors)]
                cr.set_source_rgb(r, g, b)
                cr.arc(x, y, 7, 0, 2 * math.pi)
                cr.fill()

                cr.set_source_rgb(0.9, 0.95, 1.0)
                cr.move_to(x + 10, y + 4)
                cr.show_text(f"{pol_name} ({thr:.2f}, {jain:.2f})")

