    def _launch_app(self, cmd):
        try:
            # Start completely detached in a new session so closing either app never affects the other
            subprocess.Popen(cmd, shell=True, start_new_session=True)
        except Exception as e:
            dialog = Gtk.MessageDialog(
                parent=self, flags=0, message_type=Gtk.MessageType.ERROR,
                buttons=Gtk.ButtonsType.OK, text=f"Failed to launch: {cmd}\n{e}"
            )
            dialog.run()
            dialog.destroy()


