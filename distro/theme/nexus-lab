    def _build_programs_tab(self):
        sc = Gtk.ScrolledWindow()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=16)
        sc.add(box)

        p_title = Gtk.Label(label="<b>NEXUS System Applications & Tools</b>", use_markup=True, xalign=0)
        p_title.get_style_context().add_class("title")
        p_sub = Gtk.Label(label="Launch any core development, monitoring, or kernel demonstration tool.", xalign=0)
        p_sub.get_style_context().add_class("subtitle")
        box.pack_start(p_title, False, False, 0)
        box.pack_start(p_sub, False, False, 0)

        apps = [
            ("🦀 Rust Development Studio",
             "Full IDE for compiling, editing, and executing Rust programs with Cargo.",
             "nexus-studio",
             "applications-development"),
            ("📟 Terminal",
             "Interactive bash shell for command line and package management.",
             "xfce4-terminal",
             "utilities-terminal"),
            ("📈 Task Manager & System Monitor",
             "Inspect running processes, memory allocation, CPU load, and hardware stats.",
             "nexus-tasks",
             "utilities-system-monitor"),
            ("⚙️ Micro-OS Bare-Metal Kernel Shell",
             "Boot the Rust research kernel in interactive console mode.",
             "xfce4-terminal --title=Micro-OS-Kernel -e micro-os-kernel",
             "system-run"),
            ("📁 File Manager",
             "Browse project directories, documentation, and source code.",
             "thunar",
             "system-file-manager"),
            ("🌐 Network Connections",
             "Inspect and configure Wi-Fi and Ethernet interfaces.",
             "nm-connection-editor",
             "preferences-system-network"),
        ]

        grid = Gtk.Grid()
        grid.set_column_spacing(14)
        grid.set_row_spacing(14)
        grid.set_column_homogeneous(True)
        box.pack_start(grid, False, False, 6)

        for i, (name, desc, cmd, icon_name) in enumerate(apps):
            c = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            c.get_style_context().add_class("card")

            lbl_n = Gtk.Label(label=f"<b>{name}</b>", use_markup=True, xalign=0)
            lbl_d = Gtk.Label(label=desc, xalign=0, wrap=True)
            lbl_d.get_style_context().add_class("subtitle")
            lbl_d.set_line_wrap_mode(Pango.WrapMode.WORD)

            btn = Gtk.Button(label="Launch Application")
            btn.get_style_context().add_class("primary")
            btn.connect("clicked", lambda _, c=cmd: self._launch_app(c))

            c.pack_start(lbl_n, False, False, 0)
            c.pack_start(lbl_d, True, True, 0)
            c.pack_start(btn, False, False, 4)

            grid.attach(c, i % 2, i // 2, 1, 1)

        self.notebook.append_page(sc, Gtk.Label(label="Programs"))

    def _launch_app(self, cmd):
        try:
            subprocess.Popen(cmd, shell=True)
        except Exception as e:
            dialog = Gtk.MessageDialog(
                parent=self, flags=0, message_type=Gtk.MessageType.ERROR,
                buttons=Gtk.ButtonsType.OK, text=f"Failed to launch: {cmd}\n{e}"
            )
            dialog.run()
            dialog.destroy()


