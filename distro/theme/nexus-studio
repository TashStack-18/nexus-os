    def _create_empty_project(self, name, target_dir):
        os.makedirs(os.path.join(target_dir, "src"), exist_ok=True)
        toml_content = f'[package]\nname = "{name}"\nversion = "0.1.0"\nedition = "2021"\n\n[dependencies]\n'
        main_content = f'// {name} on NEXUS OS\nfn main() {{\n    println!("Hello from {name}!");\n}}\n'
        with open(os.path.join(target_dir, "Cargo.toml"), "w") as f:
            f.write(toml_content)
        with open(os.path.join(target_dir, "src", "main.rs"), "w") as f:
            f.write(main_content)

    def _create_project_from_template(self, key, target_dir):
        if key not in EXAMPLES:
            return
        os.makedirs(os.path.join(target_dir, "src"), exist_ok=True)
        with open(os.path.join(target_dir, "Cargo.toml"), "w") as f:
            f.write(EXAMPLES[key]["toml"])
        with open(os.path.join(target_dir, "src", "main.rs"), "w") as f:
            f.write(EXAMPLES[key]["main"])

    def _on_open_project_dialog(self, _):
        fc = Gtk.FileChooserDialog(
            title="Open Project Folder",
            parent=self,
            action=Gtk.FileChooserAction.SELECT_FOLDER
        )
        fc.add_button("Cancel", Gtk.ResponseType.CANCEL)
        fc.add_button("Open", Gtk.ResponseType.OK)
        fc.set_current_folder(DEFAULT_WORKSPACE)

        if fc.run() == Gtk.ResponseType.OK:
            chosen = fc.get_filename()
            if chosen:
                self._set_active_project(chosen)
        fc.destroy()

    def _on_example_selected(self, combo):
        key = combo.get_active_id()
        if not key or key not in EXAMPLES:
            return
        self._load_example_by_key(key)
        combo.set_active(0)

    def _on_target_changed(self, combo):
        target = combo.get_active_id()
        self.is_kernel_mode = (target == "kernel")
        if self.is_kernel_mode:
            self._log_console("\n[NEXUS Studio] Target switched to: Micro-OS Bare-Metal Kernel (x86_64-unknown-none, no_std)\n")
        else:
            self._log_console("\n[NEXUS Studio] Target switched to: Debian Linux Host (std, Cargo/rustc)\n")

    # ------------------------------------------------------------- Build & Execution
    def _log_console(self, text):
        def _append():
            self.console_buf.insert(self.console_buf.get_end_iter(), text)
            it = self.console_buf.get_end_iter()
            self.console_view.scroll_to_iter(it, 0, False, 0, 0)
        GLib.idle_add(_append)

    def _clear_console(self):
        self.console_buf.set_text("")
        self.diag_store.clear()

    def _parse_diagnostics(self, stderr_text):
        err_re = re.compile(r'^(error|warning)(?:\[E\d+\])?: (.*?)$', re.MULTILINE)
        loc_re = re.compile(r'^\s*-->\s*(.*?):(\d+):(\d+)', re.MULTILINE)

        lines = stderr_text.splitlines()
        i = 0
        while i < len(lines):
            m_err = err_re.match(lines[i])
            if m_err:
                severity = m_err.group(1).upper()
                msg = m_err.group(2)
                file_p = "unknown"
                line_no = 0
                if i + 1 < len(lines):
                    m_loc = loc_re.match(lines[i+1])
                    if m_loc:
                        file_p = m_loc.group(1)
                        line_no = int(m_loc.group(2))
                self.diag_store.append([severity, file_p, line_no, msg])
            i += 1

    def _on_diag_row_activated(self, tree_view, path, column):
        model = tree_view.get_model()
        it = model.get_iter(path)
        file_name = model.get_value(it, 1)
        line_no = model.get_value(it, 2)
        if file_name and self.active_project_dir:
            target_p = os.path.join(self.active_project_dir, file_name)
            if os.path.exists(target_p):
                self._open_file_in_editor(target_p)
                _, buf = self._get_current_editor()
                if buf and line_no > 0:
                    it_line = buf.get_iter_at_line(line_no - 1)
                    buf.place_cursor(it_line)

    def _find_cargo_root(self, start_path):
        if not start_path:
            return None
        p = os.path.abspath(start_path)
        if os.path.isfile(p):
            p = os.path.dirname(p)
        while True:
            if os.path.isfile(os.path.join(p, "Cargo.toml")):
                return p
            parent = os.path.dirname(p)
            if parent == p:
                break
            p = parent
        return None

    def _run_cargo(self, args):
        if self.active_process and self.active_process.poll() is None:
            self._log_console("Another process is currently running. Click 'Stop' first.\n")
            return

        self._on_save_file()
        self._clear_console()
        self.out_notebook.set_current_page(0)

        cur_file, _ = self._get_current_editor()
        lookup_path = cur_file if cur_file else self.active_project_dir
        cargo_root = self._find_cargo_root(lookup_path)

        action = args[0] if args else "run"

        if cargo_root:
            cwd = cargo_root
            cmd = ["cargo"] + args
            if self.is_kernel_mode:
                cmd = ["cargo", "build", "--target", "x86_64-unknown-none"]
        elif cur_file and cur_file.endswith(".rs"):
            cwd = os.path.dirname(cur_file)
            bin_name = os.path.splitext(os.path.basename(cur_file))[0]
            bin_path = os.path.join("/tmp", bin_name)
            if action == "check":
                cmd = ["rustc", "--emit=metadata", "-o", "/dev/null", cur_file]
            elif action == "build":
                cmd = ["rustc", cur_file, "-o", bin_path]
            else:
                cmd = ["sh", "-c", f"rustc '{cur_file}' -o '{bin_path}' && '{bin_path}'"]
        else:
            cwd = self.active_project_dir if self.active_project_dir else DEFAULT_WORKSPACE
            cmd = ["cargo"] + args

        self._log_console(f"==> Executing: {' '.join(cmd)} in {cwd}\n")
        self.btn_stop.set_sensitive(True)
        self.statusbar.pop(self.status_context)
        self.statusbar.push(self.status_context, f"Running: {' '.join(cmd)}")

        def worker():
            try:
                env = os.environ.copy()
                env["PATH"] = f"/home/student/.cargo/bin:/root/.cargo/bin:/usr/local/bin:/usr/bin:/bin:{env.get('PATH', '')}"
                env["RUST_BACKTRACE"] = "1"
                env["CARGO_TERM_COLOR"] = "never"

                proc = subprocess.Popen(
                    cmd,
                    cwd=cwd,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    bufsize=1,
                    env=env,
                    start_new_session=True  # Enables clean process group kill
                )
                self.active_process = proc

                all_output = []
                for line in proc.stdout:
                    all_output.append(line)
                    self._log_console(line)

                rc = proc.wait()
                full_text = "".join(all_output)

                GLib.idle_add(self._parse_diagnostics, full_text)

                def on_done():
                    self.btn_stop.set_sensitive(False)
                    self.active_process = None
                    if rc == 0:
                        self._log_console(f"\n[Success] Process completed with return code {rc}\n")
                        self.statusbar.pop(self.status_context)
                        self.statusbar.push(self.status_context, "Build / Run: Succeeded")
                    else:
                        self._log_console(f"\n[Failed] Process exited with error code {rc}\n")
                        self.statusbar.pop(self.status_context)
                        self.statusbar.push(self.status_context, f"Build / Run: Failed ({rc})")
                        if len(self.diag_store) > 0:
                            self.out_notebook.set_current_page(1)

                GLib.idle_add(on_done)

            except Exception as e:
                self._log_console(f"\nExecution error: {e}\n")
                GLib.idle_add(lambda: self.btn_stop.set_sensitive(False))

        threading.Thread(target=worker, daemon=True).start()

    def _on_stop_process(self, _):
        if self.active_process and self.active_process.poll() is None:
            self._log_console("\n[NEXUS Studio] Terminating process group...\n")
            try:
                os.killpg(os.getpgid(self.active_process.pid), signal.SIGTERM)
                time.sleep(0.1)
                if self.active_process.poll() is None:
                    os.killpg(os.getpgid(self.active_process.pid), signal.SIGKILL)
            except OSError:
                try:
                    self.active_process.kill()
                except OSError:
                    pass
            self.btn_stop.set_sensitive(False)

    def _on_launch_external_term(self, _):
        cwd = self.active_project_dir if self.active_project_dir else DEFAULT_WORKSPACE
        try:
            subprocess.Popen(["xfce4-terminal", f"--working-directory={cwd}"], start_new_session=True)
        except Exception as e:
            self._log_console(f"Failed to launch terminal: {e}\n")


def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    signal.signal(signal.SIGTERM, lambda *_: os._exit(0))
    app = RustStudioApp()
    app.show_all()
    Gtk.main()
    os._exit(0)


if __name__ == "__main__":
    main()
