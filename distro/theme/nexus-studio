        buf = tv.get_buffer()
        buf.set_text(content)
        self._apply_syntax_highlighting(buf)

        buf.connect("changed", lambda b: self._apply_syntax_highlighting(b))
        buf.connect("notify::cursor-position", self._on_cursor_moved)

        sc.add(tv)
        box.pack_start(sc, True, True, 0)
        box.show_all()

        filename = os.path.basename(file_path)
        tab_label = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        lbl = Gtk.Label(label=filename)
        btn_close = Gtk.Button(label="×")
        btn_close.set_relief(Gtk.ReliefStyle.NONE)
        btn_close.connect("clicked", lambda _: self._close_editor_tab(box, file_path))
        tab_label.pack_start(lbl, False, False, 0)
        tab_label.pack_start(btn_close, False, False, 0)
        tab_label.show_all()

        page_idx = self.editor_notebook.append_page(box, tab_label)
        self.editor_notebook.set_current_page(page_idx)
        box.file_path = file_path
        box.text_view = tv
        box.text_buffer = buf

        self.active_file_path = file_path
        self._update_title()

    def _close_editor_tab(self, page_widget, file_path):
        idx = self.editor_notebook.page_num(page_widget)
        if idx != -1:
            self.editor_notebook.remove_page(idx)
        if self.editor_notebook.get_n_pages() == 0:
            self.active_file_path = None
            self._update_title()

    def _tab_switched(self, notebook, page, page_num):
        page_widget = notebook.get_nth_page(page_num)
        if hasattr(page_widget, "file_path"):
            self.active_file_path = page_widget.file_path
            self._update_title()

    def _on_tab_switched(self, notebook, page, page_num):
        self._tab_switched(notebook, page, page_num)

    def _on_cursor_moved(self, text_buf, param_spec):
        pos = text_buf.get_property("cursor-position")
        it = text_buf.get_iter_at_offset(pos)
        line = it.get_line() + 1
        col = it.get_line_offset() + 1
        self.statusbar.pop(self.status_context)
        self.statusbar.push(self.status_context, f"Ln {line}, Col {col} | UTF-8")

    def _get_current_editor(self):
        cur_idx = self.editor_notebook.get_current_page()
        if cur_idx != -1:
            page = self.editor_notebook.get_nth_page(cur_idx)
            return page.file_path, page.text_buffer
        return None, None

    # ------------------------------------------------------------- Project & File Tree
    def _load_initial_project(self):
        os.makedirs(DEFAULT_WORKSPACE, exist_ok=True)
        # Ensure Hello World example exists
        default_proj = os.path.join(DEFAULT_WORKSPACE, "01_hello_world")
        if not os.path.exists(default_proj):
            self._create_project_from_template("01_hello_world", default_proj)

        self._set_active_project(default_proj)

    def _set_active_project(self, proj_dir):
        self.active_project_dir = proj_dir
        self.sub_lbl.set_text(f"Project: {os.path.basename(proj_dir)} ({proj_dir})")
        self._refresh_file_tree()

        # Open src/main.rs by default if it exists
        main_rs = os.path.join(proj_dir, "src", "main.rs")
        if os.path.exists(main_rs):
            self._open_file_in_editor(main_rs)

    def _refresh_file_tree(self):
        self.tree_store.clear()
        if not self.active_project_dir or not os.path.exists(self.active_project_dir):
            return

        def add_nodes(parent_iter, current_path):
            try:
                entries = sorted(os.listdir(current_path))
            except OSError:
                return

            for name in entries:
                if name.startswith(".") or name == "target":
                    continue
                full_p = os.path.join(current_path, name)
                is_dir = os.path.isdir(full_p)
                rel_p = os.path.relpath(full_p, self.active_project_dir)
                node_iter = self.tree_store.append(parent_iter, [name, rel_p, full_p, is_dir])
                if is_dir:
                    add_nodes(node_iter, full_p)

        root_name = os.path.basename(self.active_project_dir)
        root_iter = self.tree_store.append(None, [f"📦 {root_name}", ".", self.active_project_dir, True])
        add_nodes(root_iter, self.active_project_dir)
        self.tree_view.expand_all()

    def _on_tree_row_activated(self, tree_view, path, column):
        model = tree_view.get_model()
        it = model.get_iter(path)
        is_dir = model.get_value(it, 3)
        full_path = model.get_value(it, 2)
        if not is_dir:
            self._open_file_in_editor(full_path)

    def _open_file_in_editor(self, full_path):
        # Check if already open
        for i in range(self.editor_notebook.get_n_pages()):
            page = self.editor_notebook.get_nth_page(i)
            if hasattr(page, "file_path") and page.file_path == full_path:
                self.editor_notebook.set_current_page(i)
                return

        try:
            with open(full_path, "r", encoding="utf-8") as f:
                content = f.read()
        except Exception as e:
            self._log_console(f"Error opening file {full_path}: {e}\n")
            return

        self._create_editor_tab(full_path, content)

    def _update_title(self):
        proj_str = os.path.basename(self.active_project_dir) if self.active_project_dir else "No Project"
        file_str = os.path.basename(self.active_file_path) if self.active_file_path else "Untitled"
        self.set_title(f"{file_str} - {proj_str} - NEXUS Rust Studio")

    # ------------------------------------------------------------- File Operations
    def _on_save_file(self):
        file_path, buf = self._get_current_editor()
        if not file_path or not buf:
            return

        start, end = buf.get_bounds()
        text = buf.get_text(start, end, False)
        try:
            with open(file_path, "w", encoding="utf-8") as f:
                f.write(text)
            self.statusbar.pop(self.status_context)
            self.statusbar.push(self.status_context, f"Saved: {os.path.basename(file_path)}")
            self._log_console(f"[NEXUS Studio] Saved {file_path}\n")
        except Exception as e:
            self._log_console(f"Save error: {e}\n")

    def _on_new_file_dialog(self, _):
        if not self.active_project_dir:
            return
        dialog = Gtk.Dialog(title="Create New File", parent=self, flags=0)
        dialog.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OK, Gtk.ResponseType.OK)
        box = dialog.get_content_area()
        box.set_spacing(8)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        box.set_margin_left(14)
        box.set_margin_right(14)

        lbl = Gtk.Label(label="File name (e.g. src/utils.rs):")
        entry = Gtk.Entry()
        entry.set_text("src/lib.rs")
        box.pack_start(lbl, False, False, 0)
        box.pack_start(entry, False, False, 0)
        dialog.show_all()

        res = dialog.run()
        if res == Gtk.ResponseType.OK:
            fname = entry.get_text().strip()
            if fname:
                target_p = os.path.join(self.active_project_dir, fname)
                os.makedirs(os.path.dirname(target_p), exist_ok=True)
                if not os.path.exists(target_p):
                    with open(target_p, "w") as f:
                        f.write("// New Rust source file\n\n")
                self._refresh_file_tree()
                self._open_file_in_editor(target_p)
