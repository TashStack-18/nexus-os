    # ------------------------------------------------------------- Syntax Highlighter
    def _apply_syntax_highlighting(self, text_buf):
        # Configure tags if not already present
        table = text_buf.get_tag_table()
        if not table.lookup("keyword"):
            tag_kw = text_buf.create_tag("keyword", foreground="#7c4dff", weight=Pango.Weight.BOLD)
            tag_type = text_buf.create_tag("type", foreground="#34d1bf", weight=Pango.Weight.BOLD)
            tag_macro = text_buf.create_tag("macro", foreground="#ffb86b", weight=Pango.Weight.BOLD)
            tag_str = text_buf.create_tag("string", foreground="#28c840")
            tag_comment = text_buf.create_tag("comment", foreground="#718096", style=Pango.Style.ITALIC)
            tag_num = text_buf.create_tag("number", foreground="#febc2e")
            tag_attr = text_buf.create_tag("attribute", foreground="#5b8cff")

        # Clear existing formatting
        start, end = text_buf.get_bounds()
        text_buf.remove_all_tags(start, end)
        content = text_buf.get_text(start, end, False)

        patterns = [
            (r'//.*$', "comment"),
            (r'/\*[\s\S]*?\*/', "comment"),
            (r'#\[.*?\]|#!\[.*?\]', "attribute"),
            (r'"(?:\\.|[^"\\])*"', "string"),
            (r"'(?:\\.|[^'\\])+'", "string"),
            (r'\b(fn|let|mut|struct|enum|impl|pub|use|mod|match|if|else|while|for|in|return|async|await|unsafe|trait|type|const|static|where|move|as|break|continue|loop)\b', "keyword"),
            (r'\b(i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|usize|isize|f32|f64|bool|char|str|String|Vec|Option|Result|Some|None|Ok|Err|Box|Arc|Mutex|Rc|Cell|RefCell)\b', "type"),
            (r'\b(println!|print!|eprintln!|format!|vec!|panic!|assert!|assert_eq!|todo!|kinfo!|ktrace!)\b', "macro"),
            (r'\b\d+(?:_\d+)*(?:\.\d+)?(?:[eE][+-]?\d+)?(?:[uif]\d+|usize)?\b', "number"),
        ]

        for regex, tag_name in patterns:
            for match in re.finditer(regex, content, re.MULTILINE):
                s_iter = text_buf.get_iter_at_offset(match.start())
                e_iter = text_buf.get_iter_at_offset(match.end())
                text_buf.apply_tag_by_name(tag_name, s_iter, e_iter)

