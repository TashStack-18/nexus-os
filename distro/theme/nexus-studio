                self._create_project_from_template(key, proj_dir)

        default_proj = os.path.join(DEFAULT_WORKSPACE, "01_hello_system")
        self._set_active_project(default_proj)

    def _set_active_project(self, proj_dir):
        self.active_project_dir = proj_dir
        self.sub_lbl.set_text(f"Project: {os.path.basename(proj_dir)}")
        self._refresh_file_tree()

        # Open src/main.rs by default if it exists
        main_rs = os.path.join(proj_dir, "src", "main.rs")
        if os.path.exists(main_rs):
            self._open_file_in_editor(main_rs)

    def _refresh_file_tree(self):
        self.tree_store.clear()
        if not self.active_project_dir or not os.path.exists(self.active_project_dir):
            return

        def add_nodes(parent_iter, current_path):
            try:
                entries = sorted(os.listdir(current_path))
            except OSError:
                return

            for name in entries:
                if name.startswith(".") or name == "target":
                    continue
                full_p = os.path.join(current_path, name)
                is_dir = os.path.isdir(full_p)
                rel_p = os.path.relpath(full_p, self.active_project_dir)
                node_iter = self.tree_store.append(parent_iter, [name, rel_p, full_p, is_dir])
                if is_dir:
                    add_nodes(node_iter, full_p)

        root_name = os.path.basename(self.active_project_dir)
        root_iter = self.tree_store.append(None, [f"📦 {root_name}", ".", self.active_project_dir, True])
        add_nodes(root_iter, self.active_project_dir)
        self.tree_view.expand_all()

    def _on_tree_row_activated(self, tree_view, path, column):
        model = tree_view.get_model()
        it = model.get_iter(path)
        is_dir = model.get_value(it, 3)
        full_path = model.get_value(it, 2)
        if not is_dir:
            self._open_file_in_editor(full_path)

    def _open_file_in_editor(self, full_path):
        for i in range(self.editor_notebook.get_n_pages()):
            page = self.editor_notebook.get_nth_page(i)
            if hasattr(page, "file_path") and page.file_path == full_path:
                self.editor_notebook.set_current_page(i)
                return

        try:
            with open(full_path, "r", encoding="utf-8") as f:
                content = f.read()
        except Exception as e:
            self._log_console(f"Error opening file {full_path}: {e}\n")
            return

        self._create_editor_tab(full_path, content)

    def _update_title(self):
        proj_str = os.path.basename(self.active_project_dir) if self.active_project_dir else "No Project"
        file_str = os.path.basename(self.active_file_path) if self.active_file_path else "Untitled"
        self.set_title(f"{file_str} - {proj_str} - NEXUS Rust Studio")

    # ------------------------------------------------------------- File Operations
    def _on_save_file(self):
        file_path, buf = self._get_current_editor()
        if not file_path or not buf:
            return

        start, end = buf.get_bounds()
        text = buf.get_text(start, end, False)
        try:
            with open(file_path, "w", encoding="utf-8") as f:
                f.write(text)
            self.statusbar.pop(self.status_context)
            self.statusbar.push(self.status_context, f"Saved: {os.path.basename(file_path)}")
        except Exception as e:
            self._log_console(f"Error saving {file_path}: {e}\n")

