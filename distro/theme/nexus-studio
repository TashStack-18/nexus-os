        "main": """// NEXUS OS - Program 5: Educational Memory Allocator Demo

const TOTAL_HEAP_BYTES: usize = 1024;
const BLOCK_SIZE: usize = 64;
const TOTAL_BLOCKS: usize = TOTAL_HEAP_BYTES / BLOCK_SIZE;

struct EducationalAllocator {
    allocated: [bool; TOTAL_BLOCKS],
}

impl EducationalAllocator {
    fn new() -> Self {
        Self {
            allocated: [false; TOTAL_BLOCKS],
        }
    }

    fn allocate(&mut self, bytes: usize) -> Result<(usize, usize), &'static str> {
        if bytes == 0 {
            return Err("Cannot allocate 0 bytes");
        }
        let needed_blocks = (bytes + BLOCK_SIZE - 1) / BLOCK_SIZE;

        // First-fit contiguous free block search
        let mut consecutive = 0;
        let mut start_index = None;

        for i in 0..TOTAL_BLOCKS {
            if !self.allocated[i] {
                consecutive += 1;
                if consecutive == needed_blocks {
                    start_index = Some(i + 1 - needed_blocks);
                    break;
                }
            } else {
                consecutive = 0;
            }
        }

        match start_index {
            Some(start) => {
                for b in start..(start + needed_blocks) {
                    self.allocated[b] = true;
                }
                let byte_offset = start * BLOCK_SIZE;
                Ok((byte_offset, needed_blocks))
            }
            None => Err("Out of memory: No contiguous free blocks found"),
        }
    }

    fn deallocate(&mut self, byte_offset: usize, blocks: usize) -> Result<(), &'static str> {
        if byte_offset % BLOCK_SIZE != 0 {
            return Err("Invalid block alignment");
        }
        let start = byte_offset / BLOCK_SIZE;
        if start + blocks > TOTAL_BLOCKS {
            return Err("Deallocation out of bounds");
        }
        for b in start..(start + blocks) {
            self.allocated[b] = false;
        }
        Ok(())
    }

    fn print_memory_map(&self) {
        print!("  Memory Map [{} blocks]: [", TOTAL_BLOCKS);
        for &is_alloc in &self.allocated {
            if is_alloc {
                print!("■");
            } else {
                print!("□");
            }
        }
        println!("] (■=Used, □=Free)");
    }
}

