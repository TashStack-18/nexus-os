    # ------------------------------------------------------------- Syntax Highlighter
    def _apply_syntax_highlighting(self, text_buf):
        table = text_buf.get_tag_table()
        if not table.lookup("keyword"):
            tag_kw = text_buf.create_tag("keyword", foreground="#c9899e", weight=Pango.Weight.BOLD)
            tag_type = text_buf.create_tag("type", foreground="#34d1bf", weight=Pango.Weight.BOLD)
            tag_macro = text_buf.create_tag("macro", foreground="#f2a7bf", weight=Pango.Weight.BOLD)
            tag_str = text_buf.create_tag("string", foreground="#a8d5ba")
            tag_comment = text_buf.create_tag("comment", foreground="#8a7384", style=Pango.Style.ITALIC)
            tag_num = text_buf.create_tag("number", foreground="#febc2e")
            tag_attr = text_buf.create_tag("attribute", foreground="#d65d8c")

        start, end = text_buf.get_bounds()
        text_buf.remove_all_tags(start, end)
        content = text_buf.get_text(start, end, False)

        patterns = [
            (r'//.*$', "comment"),
            (r'/\*[\s\S]*?\*/', "comment"),
            (r'#\[.*?\]|#!\[.*?\]', "attribute"),
            (r'"(?:\\.|[^"\\])*"', "string"),
            (r"'(?:\\.|[^'\\])+'", "string"),
            (r'\b(fn|let|mut|struct|enum|impl|pub|use|mod|match|if|else|while|for|in|return|async|await|unsafe|trait|type|const|static|where|move|as|break|continue|loop)\b', "keyword"),
            (r'\b(i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|usize|isize|f32|f64|bool|char|str|String|Vec|Option|Result|Some|None|Ok|Err|Box|Arc|Mutex|Rc|Cell|RefCell)\b', "type"),
            (r'\b(println!|print!|eprintln!|format!|vec!|panic!|assert!|assert_eq!|todo!|kinfo!|ktrace!)\b', "macro"),
            (r'\b\d+(?:_\d+)*(?:\.\d+)?(?:[eE][+-]?\d+)?(?:[uif]\d+|usize)?\b', "number"),
        ]

        for regex, tag_name in patterns:
            for match in re.finditer(regex, content, re.MULTILINE):
                s_iter = text_buf.get_iter_at_offset(match.start())
                e_iter = text_buf.get_iter_at_offset(match.end())
                text_buf.apply_tag_by_name(tag_name, s_iter, e_iter)

    # ------------------------------------------------------------- Editor Tabs
    def _create_editor_tab(self, file_path, content=""):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        sc = Gtk.ScrolledWindow()
        tv = Gtk.TextView()
        tv.get_style_context().add_class("editor")
        tv.set_monospace(True)
        tv.set_left_margin(12)
        tv.set_right_margin(12)

        buf = tv.get_buffer()
        buf.set_text(content)
        self._apply_syntax_highlighting(buf)

        buf.connect("changed", lambda b: self._apply_syntax_highlighting(b))
        buf.connect("notify::cursor-position", self._on_cursor_moved)

        sc.add(tv)
        box.pack_start(sc, True, True, 0)
        box.show_all()

        filename = os.path.basename(file_path)
        tab_label = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        lbl = Gtk.Label(label=filename)
        btn_close = Gtk.Button(label="×")
        btn_close.set_relief(Gtk.ReliefStyle.NONE)
        btn_close.connect("clicked", lambda _: self._close_editor_tab(box, file_path))
        tab_label.pack_start(lbl, False, False, 0)
        tab_label.pack_start(btn_close, False, False, 0)
        tab_label.show_all()

        page_idx = self.editor_notebook.append_page(box, tab_label)
        self.editor_notebook.set_current_page(page_idx)
        box.file_path = file_path
        box.text_view = tv
        box.text_buffer = buf

        self.active_file_path = file_path
        self._update_title()

    def _close_editor_tab(self, page_widget, file_path):
        idx = self.editor_notebook.page_num(page_widget)
        if idx != -1:
            self.editor_notebook.remove_page(idx)
        if self.editor_notebook.get_n_pages() == 0:
            self.active_file_path = None
            self._update_title()

    def _on_tab_switched(self, notebook, page, page_num):
        page_widget = notebook.get_nth_page(page_num)
        if hasattr(page_widget, "file_path"):
            self.active_file_path = page_widget.file_path
            self._update_title()

    def _on_cursor_moved(self, text_buf, param_spec):
        pos = text_buf.get_property("cursor-position")
        it = text_buf.get_iter_at_offset(pos)
        line = it.get_line() + 1
        col = it.get_line_offset() + 1
        self.statusbar.pop(self.status_context)
        self.statusbar.push(self.status_context, f"Ln {line}, Col {col} | UTF-8")

    def _get_current_editor(self):
        cur_idx = self.editor_notebook.get_current_page()
        if cur_idx != -1:
            page = self.editor_notebook.get_nth_page(cur_idx)
            return page.file_path, page.text_buffer
        return None, None

