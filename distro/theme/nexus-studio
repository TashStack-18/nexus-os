    def _load_initial_project(self):
        os.makedirs(DEFAULT_WORKSPACE, exist_ok=True)
        # Ensure all 6 example programs exist
        for key in EXAMPLES:
            proj_dir = os.path.join(DEFAULT_WORKSPACE, key)
