class RustStudioApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="LUNARA Rust Development Studio")
        self.set_default_size(1180, 780)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_wmclass("lunara-studio", "Lunara-studio")
        self.set_role("lunara-studio")
        self.set_decorated(True)
        self.connect("delete-event", self._on_delete_event)
        self.connect("destroy", self._on_destroy)

        self.active_project_dir = None
        self.active_file_path = None
        self.active_process = None
        self.is_kernel_mode = False

        self._setup_style()
        self._init_ui()
        self._load_initial_project()

    def _on_delete_event(self, widget, event):
        self._cleanup_and_quit()
        return False

    def _on_destroy(self, widget):
        self._cleanup_and_quit()

    def _cleanup_and_quit(self):
        if self.active_process and self.active_process.poll() is None:
            try:
                os.killpg(os.getpgid(self.active_process.pid), signal.SIGKILL)
            except Exception:
                try:
                    self.active_process.kill()
                except Exception:
                    pass
        try:
            Gtk.main_quit()
        except Exception:
            pass
        os._exit(0)

    def _setup_style(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(DARK_CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def _init_ui(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(vbox)

        # 1. Top Header Bar / Toolbar
        top_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6, margin=8)
        top_bar.get_style_context().add_class("card")
        vbox.pack_start(top_bar, False, False, 0)

        # Brand / Title
        brand_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_lbl = Gtk.Label(xalign=0)
        title_lbl.set_markup("<b>LUNARA Rust Studio</b>")
        title_lbl.get_style_context().add_class("title")
        self.sub_lbl = Gtk.Label(label="No project loaded", xalign=0)
        self.sub_lbl.get_style_context().add_class("subtitle")
        brand_box.pack_start(title_lbl, False, False, 0)
        brand_box.pack_start(self.sub_lbl, False, False, 0)
        top_bar.pack_start(brand_box, False, False, 6)

        sep1 = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
