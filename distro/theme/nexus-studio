    println!("Total Heap Capacity: {} bytes ({} blocks of {}B each)\\n", TOTAL_HEAP_BYTES, TOTAL_BLOCKS, BLOCK_SIZE);

    let mut heap = EducationalAllocator::new();
    heap.print_memory_map();

    println!("\\n[1] Allocating Block A (120 bytes -> 2 blocks):");
    let (off_a, blk_a) = heap.allocate(120).unwrap();
