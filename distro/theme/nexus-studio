    def _on_new_project_dialog(self, _):
        dialog = Gtk.Dialog(title="Create New Rust Project", parent=self, flags=0)
        dialog.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OK, Gtk.ResponseType.OK)
        box = dialog.get_content_area()
        box.set_spacing(8)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        box.set_margin_left(14)
        box.set_margin_right(14)

        lbl = Gtk.Label(label="Project Name:")
        entry = Gtk.Entry()
        entry.set_text("my_nexus_app")
        box.pack_start(lbl, False, False, 0)
        box.pack_start(entry, False, False, 0)

        tmpl_lbl = Gtk.Label(label="Template:")
        combo = Gtk.ComboBoxText()
        for k, v in EXAMPLES.items():
            combo.append(k, v["title"])
