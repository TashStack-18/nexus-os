def read_cpu_stat():
    try:
        with open("/proc/stat") as f:
            line = f.readline()
        parts = [float(x) for x in line.split()[1:]]
        idle = parts[3] + parts[4]
        total = sum(parts)
        return total, idle
    except Exception:
        return 0, 0

def read_meminfo():
    res = {}
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                parts = line.split(":")
                if len(parts) == 2:
                    k = parts[0].strip()
                    v = int(parts[1].split()[0])
                    res[k] = v
    except Exception:
        pass
    return res

class NexusTaskManager(Gtk.Window):
    def __init__(self):
        super().__init__(title="NEXUS Task Manager & System Monitor")
        self.set_default_size(1080, 720)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_wmclass("nexus-tasks", "Nexus-tasks")
        self.set_role("nexus-tasks")
        self.connect("delete-event", self._on_delete_event)
        self.connect("destroy", self._on_destroy)

        self.running = True
        self.prev_proc_cpu = {}  # pid -> (cpu_time, timestamp)
        self.prev_sys_cpu = read_cpu_stat()

        self._setup_style()
        self._init_ui()
        self._start_refresh_thread()

    def _on_delete_event(self, widget, event):
        self._cleanup_and_quit()
        return False

    def _on_destroy(self, _):
        self._cleanup_and_quit()

    def _cleanup_and_quit(self):
        self.running = False
        try:
            Gtk.main_quit()
        except Exception:
            pass
        os._exit(0)

