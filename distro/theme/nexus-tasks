    def _on_end_task(self, _):
        sel, it = self.proc_tree.get_selection().get_selected()
        if it:
            pid = sel.get_value(it, 0)
            pname = sel.get_value(it, 1)
            try:
                os.kill(pid, signal.SIGTERM)
                dialog = Gtk.MessageDialog(
                    parent=self, flags=0, message_type=Gtk.MessageType.INFO,
                    buttons=Gtk.ButtonsType.OK, text=f"Terminated process {pname} (PID {pid})."
                )
                dialog.run()
                dialog.destroy()
            except Exception as e:
                try:
                    os.kill(pid, signal.SIGKILL)
                except Exception as e2:
                    dialog = Gtk.MessageDialog(
                        parent=self, flags=0, message_type=Gtk.MessageType.ERROR,
                        buttons=Gtk.ButtonsType.OK, text=f"Failed to kill PID {pid}: {e2}"
                    )
                    dialog.run()
                    dialog.destroy()

