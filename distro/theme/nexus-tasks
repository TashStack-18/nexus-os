    # =========================================================================
    # REFRESH THREAD
    # =========================================================================
    def _start_refresh_thread(self):
        def worker():
            while self.running:
                # 1. System stats
                tot, idle = read_cpu_stat()
                prev_tot, prev_idle = self.prev_sys_cpu
                diff_tot = max(1.0, tot - prev_tot)
                diff_idle = idle - prev_idle
                cpu_pct = max(0.0, min(100.0, ((diff_tot - diff_idle) / diff_tot) * 100.0))
                self.prev_sys_cpu = (tot, idle)

                mem = read_meminfo()
                tot_mem = mem.get("MemTotal", 1024)
                avail_mem = mem.get("MemAvailable", tot_mem)
                used_mem = tot_mem - avail_mem
                mem_pct = (used_mem / max(1.0, tot_mem)) * 100.0

                # 2. Process list
                search_query = self.entry_search.get_text().strip().lower()
                procs = []
                now = time.monotonic()

                try:
                    pids = [int(p) for p in os.listdir("/proc") if p.isdigit()]
                except Exception:
                    pids = []

                for pid in pids:
                    try:
                        stat_path = f"/proc/{pid}/stat"
                        with open(stat_path) as f:
                            content = f.read()
                        rparen = content.rfind(")")
                        name = content[content.find("(") + 1:rparen]
                        rest = content[rparen + 2:].split()
                        state_code = rest[0]
                        nice = int(rest[16])
                        utime = int(rest[11])
                        stime = int(rest[12])
                        rss_pages = int(rest[21])
                        rss_mb = (rss_pages * 4096) / (1024 * 1024)

                        state_map = {"R": "Running", "S": "Sleeping", "D": "Disk Sleep", "Z": "Zombie", "T": "Stopped"}
                        state_str = state_map.get(state_code, state_code)

                        # CPU %
                        total_proc_time = utime + stime
                        proc_cpu_pct = 0.0
                        if pid in self.prev_proc_cpu:
                            prev_t, prev_time = self.prev_proc_cpu[pid]
                            dt = now - prev_time
                            if dt > 0.0:
                                proc_cpu_pct = max(0.0, ((total_proc_time - prev_t) / 100.0) / dt * 100.0)
                        self.prev_proc_cpu[pid] = (total_proc_time, now)

                        cmd_path = f"/proc/{pid}/cmdline"
                        try:
                            with open(cmd_path, "rb") as f:
                                cmd = f.read().replace(b"\0", b" ").decode("utf-8", "ignore").strip()
                        except Exception:
                            cmd = name

                        if not cmd:
                            cmd = f"[{name}]"

                        if not search_query or (search_query in name.lower() or search_query in str(pid)):
                            procs.append((pid, name, state_str, f"{proc_cpu_pct:.1f}%", f"{rss_mb:.1f}", nice, cmd))

                    except Exception:
                        continue

                # Sort by CPU% or Memory
                procs.sort(key=lambda x: float(x[4]), reverse=True)

                def update_gui(c_pct=cpu_pct, m_pct=mem_pct, u_m=used_mem, t_m=tot_mem, p_list=procs):
                    self.lbl_cpu_quick.set_text(f"CPU: {c_pct:.1f}%")
                    self.lbl_mem_quick.set_text(f"RAM: {m_pct:.1f}%")
                    self.h_sub.set_text(f"{len(p_list)} tasks active | Memory: {u_m // 1024} MB in use")

                    self.prog_cpu.set_fraction(c_pct / 100.0)
                    self.lbl_cpu_detail.set_text(f"{c_pct:.1f}%")

                    self.prog_mem.set_fraction(m_pct / 100.0)
                    self.lbl_mem_detail.set_text(f"{u_m // 1024} MB / {t_m // 1024} MB ({m_pct:.1f}%)")

                    # Update system info tree
                    self.sys_info_store.clear()
                    uname = os.uname()
                    with open("/proc/uptime") as f:
                        up_secs = float(f.read().split()[0])
                    up_str = f"{int(up_secs // 3600)}h {int((up_secs % 3600) // 60)}m {int(up_secs % 60)}s"

                    sys_props = [
                        ("Operating System", "NEXUS OS (Debian 13 + Rust Micro-OS)"),
                        ("Kernel Release", f"{uname.sysname} {uname.release}"),
                        ("Hardware Architecture", uname.machine),
                        ("System Uptime", up_str),
                        ("Total Physical RAM", f"{t_m // 1024} MB"),
                        ("Available RAM", f"{mem.get('MemAvailable', 0) // 1024} MB"),
                        ("Swap Total / Free", f"{mem.get('SwapTotal', 0) // 1024} MB / {mem.get('SwapFree', 0) // 1024} MB"),
                    ]
                    for prop in sys_props:
                        self.sys_info_store.append(list(prop))

                    # Update process list
                    self.proc_store.clear()
                    for p in p_list[:120]:
                        self.proc_store.append(list(p))

                GLib.idle_add(update_gui)
                time.sleep(1.5)

        threading.Thread(target=worker, daemon=True).start()

    def _on_destroy(self, _):
        self.running = False
        Gtk.main_quit()

def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    signal.signal(signal.SIGTERM, lambda *_: os._exit(0))
    win = NexusTaskManager()
    win.show_all()
    Gtk.main()
    os._exit(0)

if __name__ == "__main__":
    main()
