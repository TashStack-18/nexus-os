        try:
            os.makedirs(d, exist_ok=True)
            with open(os.path.join(d, name + ".py"), "w") as f:
                f.write(code)
        except OSError:
            pass
        launch(name, code)
    myrun.connect("clicked", run_mine)

    def end_task(_):
        sel, it = ttv.get_selection().get_selected()
        if it:
            pid = sel[it][0]
            t = tasks.get(pid)
            if t:
                try:
                    t["proc"].kill()
                except OSError:
                    pass
    killb.connect("clicked", end_task)

    def refresh():
        tstore.clear()
        for pid, t in list(tasks.items()):
            alive = t["proc"].poll() is None
            state, pct = "finished", 0.0
            if alive:
                try:
                    with open("/proc/%d/stat" % pid) as f:
                        fld = f.read().rsplit(")", 1)[1].split()
                    state = {"R": "running", "S": "sleeping", "D": "waiting (I/O)", "T": "stopped"}.get(fld[0], fld[0])
                    cpu = int(fld[11]) + int(fld[12])
                    now = time.monotonic()
                    pct = max(0.0, (cpu - t["last"]) * 100.0 / hz / max(now - t["t"], 0.05))
                    t["last"], t["t"] = cpu, now
                except (OSError, IndexError, ValueError):
                    state = "finished"
            tstore.append([pid, t["name"], state, "%.0f" % pct, t["nice"], "%.0f s" % (time.monotonic() - t["t0"])])
            if not alive and time.monotonic() - t["t"] > 30:
                del tasks[pid]
        return True
    GLib.timeout_add(1000, refresh)

    win.show_all()
    Gtk.main()


